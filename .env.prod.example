# Postgres : choisir un mot de passe fort, pas de defaut en prod
POSTGRES_DB=habilitation
POSTGRES_USER=habilitation
POSTGRES_PASSWORD=

# JWT secret : generer avec
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Cle de chiffrement Fernet (pour l'etape 3 : chiffrement des fichiers).
# Generer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT : ne JAMAIS regenerer cette cle apres mise en prod sinon les
# documents deja chiffres deviennent illisibles.
FILE_ENCRYPTION_KEY=

# CORS : domaine du frontend (ajouter d'autres origines separees par virgule
# une fois le frontend en ligne)
CORS_ORIGINS=https://formations.alex-worksmart.com

# Protege POST /api/internal/sync/depantime, qui force une synchronisation
# immediate. La synchro periodique tourne sans lui (app/scheduler.py) : vide,
# seul le declenchement manuel est desactive. Generer :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REMINDERS_SECRET=

# Cadence de la synchronisation de l'equipe, en minutes (defaut 60).
SYNC_INTERVAL_MINUTES=60

# Secret partage avec le dashboard de pilotage du site web. Protege
# GET /api/pilotage/snapshot (taux de conformite global). Coller la
# meme valeur dans HABILITATION_PILOTAGE_SECRET cote Cloudflare Pages.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PILOTAGE_SECRET=

# URL du frontend en prod, utilisee pour construire les magic_link
# inseres dans les emails de relance.
FRONTEND_BASE_URL=https://formations.alex-worksmart.com

# Resend (https://resend.com) : envoi des emails de demande de document
# au depanneur. Generer une cle dans Resend > API Keys, autoriser
# l'adresse MAIL_FROM dans Resend > Domains. Si vide, le bouton
# 'Envoyer la demande' fallback sur le magic_link copiable.
RESEND_API_KEY=
MAIL_FROM=Habilitations 1MDP <habilitations@TON-DOMAINE>
MAIL_REPLY_TO=

# DocuSign (etape 10e : signature de l'attestation sur l'honneur).
# Authentification JWT Grant. Desactivee si integration/user/account ou la
# cle privee manquent.
# Cle privee RSA, 2 options (comme DepanTime) :
#  - RECOMMANDE : deposer le fichier .key sur le VPS a
#    /srv/habilitation/docusign-private.key (monte par docker-compose.prod.yml
#    sur /app/docusign-private.key). Laisser alors DOCUSIGN_PRIVATE_KEY vide.
#  - Sinon inline dans DOCUSIGN_PRIVATE_KEY : cle sur une seule ligne, retours
#    a la ligne en \n litteraux.
# ENV : 'production' (account.docusign.com) ou 'demo' (account-d.docusign.com).
# Au 1er appel DocuSign peut exiger un consentement admin : l'erreur renvoyee
# contient l'URL de consentement a ouvrir une fois.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Laisser vide si la cle est fournie via le fichier monte (recommande).
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_TEMPLATE_ID=6da048a0-92a0-458e-a0e8-a2ae33090940
DOCUSIGN_ROLE_NAME=Salarie
DOCUSIGN_ENV=production

# ── Comptes administrateurs ─────────────────────────────────────────────
# Declares dans backend/app/comptes.py, mot de passe ici. Sans la variable,
# le compte n'est pas cree. Ils sont reappliques a chaque demarrage.
HB_PASS_ALEXANDRE=
HB_PASS_NORBERT=
HB_PASS_SANDRINE=
HB_PASS_ILIES=

# ---- Synchronisation de l'equipe depuis DepanTime ----
# DepanTime est la source de verite des fiches depanneurs : un depanneur ajoute
# ou archive la-bas l'est aussi ici. Le secret doit etre identique a
# HABILITATION_SECRET dans le .env de DepanTime. Laisser vide desactive la
# synchro (la liste se gere alors a la main).
#   openssl rand -base64 32
DEPANTIME_BASE_URL=https://depantime.alex-worksmart.com
DEPANTIME_SECRET=
